# Copy to .env and adjust. Every value is optional; the defaults are shown.
# No API keys are needed: all models run locally through Ollama.

# --- Ollama -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:14b            # use qwen3:8b on machines with less memory
LLM_TEMPERATURE=0.2
LLM_REASONING=false            # true = let Qwen3 "think" first (slower; reasoning is hidden)
EMBED_MODEL=bge-m3

# --- Storage ------------------------------------------------------------
DATA_DIR=data                  # PDFs in DATA_DIR/raw, extracted pages in DATA_DIR/processed
CHROMA_DIR=data/chroma
COLLECTION_NAME=pdf_rag

# --- Ingestion / retrieval ---------------------------------------------
OCR_LANG=eng+mar               # tesseract languages; missing packs are skipped with a warning
OCR_MODE=auto                  # auto (scanned or garbled pages only) | always | never
OCR_DPI=300
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
